{
  "Serilog": {
    "Using":  [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "MySqlDatabaseSettings": {
    "Host": "localhost",
    "Port": "3306",
    "DatabaseName": "post-database",
    "Username": "post-user",
    "Password": "post-db-pw"
  },
  "RabbitMQSettings": {
    "Host": "rabbitmq://localhost:5672/",
    "QueueName": "postservice"
  },
  "AllowedHosts": "*"
}